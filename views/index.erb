<!DOCTYPE html>
<!-- The page shell. Server-rendered snapshot of the transcript and
     status bar; public/app.js then connects an EventSource and
     applies deltas. Block divs are addressed by their transcript id —
     the SSE `block` event upserts by id, `remove` deletes by id.

     `data-theme` carries the resolved `theme` cookie so the first paint
     is already in the right palette; the toggle's label names the theme
     it switches *to*, and app.js keeps both in sync after a click. -->
<html lang="en" data-theme="<%= theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>pikuri-web</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main id="transcript">
    <% blocks.each do |block| %>
    <div class="block <%= block.kind %>" id="<%= block.id %>"><%== block.html %></div>
    <% end %>
  </main>

  <form id="composer">
    <textarea name="prompt" id="prompt" rows="3" autofocus
              placeholder="Message… (Enter to send, Shift+Enter for newline; sending mid-turn injects)"></textarea>
    <div class="composer-buttons">
      <button type="submit" id="send">Send</button>
      <button type="button" id="cancel" <%= 'hidden' unless status[:busy] %>>Cancel</button>
    </div>
  </form>

  <footer id="status-bar">
    <span id="status-state"><%= status[:busy] ? 'busy' : 'idle' %></span>
    <span id="status-pending"><%= status[:pending].positive? ? "#{status[:pending]} queued" : '' %></span>
    <span id="status-tokens"><%= status[:tokens] %></span>
    <button type="button" id="theme-toggle"
            title="Switch to the <%= theme == 'dark' ? 'light' : 'dark' %> theme"
            aria-label="Switch to the <%= theme == 'dark' ? 'light' : 'dark' %> theme"><%=
      theme == 'dark' ? '☀ light' : '☾ dark'
    %></button>
  </footer>

  <script src="/app.js"></script>
</body>
</html>
