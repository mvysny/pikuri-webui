<%# The conversation list. Rendered into index.erb's <nav id="sidebar">, and
    served on its own by GET /conversations so app.js can drop a fresh copy
    into that nav when the live conversation changes.

    Each row is a form, not a link: selecting a conversation changes server
    state, and a prefetching browser must not be able to do that with a GET.
    app.js intercepts the submit; without JavaScript the POST redirects back
    to a freshly rendered page. Rows are disabled mid-turn — one conversation
    is live, and a switch would have to throw the running turn away.

    Delete is a second submit button in the *same* form, aimed elsewhere with
    `formaction`: a nested form would be invalid HTML, and two sibling forms
    could not share the row's flex line. Select stays first, so Enter still
    selects. %>
<ul class="conversations">
  <% conversations.each do |c| %>
  <li>
    <form method="post" action="/conversations/<%= c[:id] %>/select">
      <button type="submit"
              class="conversation<%= ' current' if c[:current] %><%= ' unsupported' unless c[:supported] %>"
              aria-current="<%= c[:current] %>"
              title="<%= busy ? 'the agent is mid-turn' : c[:title] %>"
              <%= 'disabled' if busy %>>
        <span class="conversation-title"><%= c[:title] %></span>
        <span class="conversation-time"><%= c[:supported] ? c[:ago] : 'unsupported format' %></span>
      </button>
      <button type="submit" formaction="/conversations/<%= c[:id] %>/delete"
              class="conversation-delete"
              aria-label="Delete the conversation <%= c[:title] %>"
              title="<%= busy ? 'the agent is mid-turn' : 'Delete this conversation' %>"
              <%= 'disabled' if busy %>>&times;</button>
    </form>
  </li>
  <% end %>
</ul>
