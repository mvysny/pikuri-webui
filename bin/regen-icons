#!/usr/bin/env ruby
# frozen_string_literal: true

# Re-render every plated icon in public/images/ from kuri.svg, the master.
#
# This script is the icon manual: the TARGETS table below is the authority on
# what each icon is, and running it is the whole procedure. Why the icons are
# plated at all - and why the master stays transparent - is DECISIONS.md
# D_icon_plate; that entry argues the fork, this file performs it.
#
#   bin/regen-icons
#
# Run it after any change to public/images/kuri.svg. That file is a VERBATIM
# copy of ../pikuri/assets/kuri.svg - byte for byte, comments and all - and the
# library is its only source of truth. Nothing here edits it: a mascot change is
# re-copy from upstream, then run this. Any local tweak to the drawing is lost
# at the next copy, and silently, because nothing compares the two.
#
# Needs one SVG rasterizer on PATH: rsvg-convert, magick or inkscape.
#
# Nothing calls this at boot or at build time. The project has no build step
# (D_no_js_build_step) and the PNGs are committed artifacts; this exists so the
# geometry, the plate colour and the five sizes have one home instead of being
# retyped out of a table in prose.

require 'fileutils'
require 'tmpdir'

IMAGES = File.expand_path('../public/images', __dir__)
MASTER = File.join(IMAGES, 'kuri.svg')

# The plate colour. Baked in rather than read from a CSS token because a
# launcher renders an icon file without ever loading the page - see
# D_icon_plate's note on this being a sanctioned raw colour.
PLATE = '#1e1f22'

# Every wrapper is authored in one 64-unit square and left to the rasterizer to
# scale, so the corner radius and the art fraction are single numbers rather
# than a per-size column. The master's art box is 56x56 centred on (32,35) -
# stated in kuri.svg's own header, and the one fact here that comes from it.
CANVAS = 64
ART_BOX = 56
ART_CX = 32
ART_CY = 35
CORNER = 13 # 20.3% - the 104/39/6.5 radii of the old table, in 64-space

# What we ship. `art` is the fraction of the plate's width the drawing spans;
# `round` is a rounded plate, false a full-bleed square one.
#
# The percentages are taste except for the maskable one, which is a bound:
# Android keeps only the centred circle of 80% diameter, and Kuri's widest
# point (an ear's outer edge) sits at 0.518x his own width from centre, so art
# much above 77% starts losing an ear. 74% is that bound with margin.
TARGETS = [
  { file: 'icon-32.png',           px: 32,  art: 0.82, round: true },
  { file: 'icon-192.png',          px: 192, art: 0.76, round: true },
  { file: 'icon-512.png',          px: 512, art: 0.76, round: true },
  # iOS applies its own superellipse mask, so a rounded plate would be clipped
  # twice and show pale corners.
  { file: 'apple-touch-icon.png',  px: 180, art: 0.72, round: false },
  { file: 'icon-maskable-512.png', px: 512, art: 0.74, round: false },
  # The tab icon is the same wrapper, kept as SVG. It is the "one sanctioned
  # copy" of the master's geometry that D_icon_plate names - a favicon cannot
  # reference an external file - and it is generated for exactly that reason.
  { file: 'favicon.svg',           px: nil, art: 0.82, round: true }
].freeze

# The master's drawing, without its <svg> shell, <title> or comments: what goes
# inside a plated wrapper.
def master_body
  svg = File.read(MASTER)
  inner = svg[/<svg\b[^>]*>(.*)<\/svg>/m, 1] or
    abort "regen-icons: #{MASTER} has no <svg> element"
  inner = inner.gsub(/<!--.*?-->/m, '').gsub(%r{<title>.*?</title>}m, '')
  # Blank lines go, per-line indentation stays: the nesting inside the drawing
  # is the master's, and stripping the whole string would flatten its first
  # line against the rest.
  inner.split("\n").reject { |l| l.strip.empty? }.join("\n")
end

def wrapper(body, art:, round:)
  scale = (art * CANVAS / ART_BOX).round(6)
  plate = format('<rect width="%d" height="%d"%s fill="%s"/>',
                 CANVAS, CANVAS, round ? %( rx="#{CORNER}") : '', PLATE)
  <<~SVG
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 #{CANVAS} #{CANVAS}" role="img" aria-label="pikuri">
      <!-- GENERATED by bin/regen-icons from kuri.svg - do not edit by hand.
           Kuri on pikuri's own background token: the Talus coat is a mid grey,
           and a mid grey on a white tab strip is a pale smudge at 16px. See
           DECISIONS.md D_icon_plate. -->
      <title>pikuri</title>
      #{plate}
      <g transform="translate(#{CANVAS / 2},#{CANVAS / 2}) scale(#{scale}) translate(#{-ART_CX},#{-ART_CY})">
    #{body.gsub(/^/, '    ')}
      </g>
    </svg>
  SVG
end

# The first rasterizer on PATH, as a command builder. rsvg-convert first: it is
# the only one of the three that renders SVG natively rather than through a
# delegate, so it is the one whose output we have actually looked at.
RASTERIZERS = {
  'rsvg-convert' => ->(src, out, px) { ['rsvg-convert', '-w', px.to_s, '-h', px.to_s, '-o', out, src] },
  'magick' => ->(src, out, px) { ['magick', '-background', 'none', '-size', "#{px}x#{px}", src, out] },
  'inkscape' => ->(src, out, px) { ['inkscape', src, '-o', out, '-w', px.to_s, '-h', px.to_s] }
}.freeze

# Scanned rather than shelled out to: `command -v` is a shell builtin, so
# system('command', '-v', x) looks for a binary named "command" and reports
# every rasterizer missing.
def on_path?(cmd)
  ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).any? do |dir|
    exe = File.join(dir, cmd)
    File.executable?(exe) && !File.directory?(exe)
  end
end

def rasterizer
  name = RASTERIZERS.keys.find { |c| on_path?(c) }
  name or abort <<~MSG
    regen-icons: no SVG rasterizer on PATH.
    Install one of: #{RASTERIZERS.keys.join(', ')}
      Debian/Ubuntu: apt install librsvg2-bin
      macOS:         brew install librsvg
  MSG
  [name, RASTERIZERS[name]]
end

body = master_body
svg_targets, png_targets = TARGETS.partition { |t| t[:px].nil? }

# Resolved before anything is written, so a missing rasterizer leaves the whole
# icon set untouched rather than half-regenerated.
name, build = rasterizer unless png_targets.empty?

svg_targets.each do |t|
  path = File.join(IMAGES, t[:file])
  File.write(path, wrapper(body, art: t[:art], round: t[:round]))
  puts "  #{t[:file]}"
end

unless png_targets.empty?
  puts "rasterizing with #{name}"
  Dir.mktmpdir('regen-icons') do |tmp|
    png_targets.each do |t|
      src = File.join(tmp, "#{File.basename(t[:file], '.png')}.svg")
      out = File.join(IMAGES, t[:file])
      File.write(src, wrapper(body, art: t[:art], round: t[:round]))
      system(*build.call(src, out, t[:px]), exception: true)
      puts format('  %-24s %dx%d', t[:file], t[:px], t[:px])
    end
  end
end

puts "done - #{TARGETS.size} files in public/images/"
