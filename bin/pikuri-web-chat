#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the web chat shell built on Pikuri::Agent — the browser
# sibling of pikuri-tui's bin/pikuri-tui-chat, wiring the same agent /
# tool set into a Sinatra app instead of a Tuile screen.
#
# The `-chat` suffix is load-bearing: this script's tool set holds no
# disk, shell or repo tool, and the README sells that absence as the
# reason you can talk to it freely. An OS or code shell would be a
# sibling script reusing the same Pikuri-free plumbing — never extra
# tools added below. See AGENTS.md, "The chat script stays chat-only".
#
# Pin Bundler to this project's Gemfile so locked dependency versions win
# and the script works when invoked via a symlink from any working
# directory. `__dir__` resolves through symlinks, so this points at the
# real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'

# Only for the :after_stopped hook wired below; Sinatra's run! loads the
# rest of Puma through the rackup handler.
require 'puma/events'

# pikuri-web has no published gemspec yet, so its lib/ is not on
# Bundler's load path. Adding it here lets `require 'pikuri_web'`
# resolve through Zeitwerk.
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-pdf'
require 'pikuri_web'

# CLI overrides start nil ("flag not given") so PikuriWeb::Config can tell
# an explicit flag from an absent one; they override the primary [[llm]]
# connection's fields. Built-in connection defaults live in Config, the
# single source of truth shown in --help. --port / --bind are ours alone
# and have no config-file home.
cli_server = nil
cli_model  = nil
port = 4567
bind = '127.0.0.1'
dev = false

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-web-chat [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--server URL', "LLM server base URL (default: #{PikuriWeb::Config::DEFAULT_SERVER})") { |v| cli_server = v }
  opts.on('--model NAME', "Model identifier (default: #{PikuriWeb::Config::DEFAULT_MODEL})") { |v| cli_model = v }
  opts.on('--port PORT', Integer, "HTTP port to listen on (default: #{port})") { |v| port = v }
  opts.on('--bind ADDR', "Address to bind (default: #{bind}; this app has no auth — keep it loopback)") { |v| bind = v }
  opts.on('--dev', 'Development mode: re-read views/*.erb per request, exception pages in the browser') { dev = true }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Load the layered config (XDG search path, shared with pikuri-tui) and
# overlay the CLI flags. There is no --api-key flag: a key must never
# travel on the command line (visible in ps / shell history) — it comes
# only from the config file. Boot-time, before Puma binds, so a bad file
# is a plain warn + exit rather than a server that serves a broken agent.
begin
  config = PikuriWeb::Config.load(overrides: { server: cli_server, model: cli_model })
  # Asked here rather than left to WebSearch.build below, so an unusable
  # [search] selection exits like any other config error instead of a
  # backtrace out of the agent wiring.
  Pikuri::Tool::Search::Engines.resolve(**config.search.to_h)
rescue PikuriWeb::Config::Error, ArgumentError => e
  warn "config error: #{e.message}"
  exit 2
end

llm = config.primary_llm
api_key = llm.api_key
api_key = 'not-needed' if api_key.nil? || api_key.strip.empty?

Pikuri::Extractors::PDF.register

# — the Pikuri-free plumbing —

transcript = PikuriWeb::Transcript.new
broadcaster = PikuriWeb::Broadcaster.new

# Everything this shell persists lives under one folder named after the
# script, inside pikuri's own state root — so `rm -r` on it is a complete
# reset, and a sibling script (an OS or code shell) gets its own without
# either having to know what the other stores. Any future state goes here
# too, never straight into Paths.state.
state_root = Pikuri::Paths.state / 'pikuri-web-chat'

# Saved conversations fill the sidebar; nothing loads one back yet, so
# "+ new conversation" saves the current one and clears the agent.
conversations = PikuriWeb::ConversationStore.new(
  root: state_root / 'conversations',
  shell: 'pikuri-web-chat',
  model: llm.model
)

# Diagnostics go to stderr — pikuri's per-subsystem loggers and
# PikuriWeb's own logger both default there. The browser shows the
# conversation transcript only (see AGENTS.md).

# — the agent (same wiring as bin/pikuri-tui-chat, plus the Interloper) —

cancel_flag = Pikuri::Agent::Control::Cancellable.new
interloper = Pikuri::Agent::Control::Interloper.new

system_prompt = Pikuri.prompts(:'pikuri-chat', :'agent-loop')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

# Constructed up front so the Agent's ListenerList and the AgentRunner
# (for the status bar's token readout) see the same TokenLog instance.
token_log = Pikuri::Agent::Listener::TokenLog.new

sse_listener = PikuriWeb::SseListener.new(transcript: transcript, broadcaster: broadcaster)

# Coalesce streaming delta chunks at 15 fps before they reach the
# kramdown-rendering SseListener: a fast llama.cpp can emit dozens of
# deltas per second and re-rendering + broadcasting every one is wasted
# work the user can't perceive. flush_pending_on_non_delta: false because
# the Assistant / Thinking bookend events re-render the authoritative
# final content (see StreamingMessage#finalize), so emitting the trailing
# 0–66 ms of buffered deltas right before that is pure waste.
rate_limited_listener = Pikuri::Agent::Listener::RateLimited.new(
  sse_listener,
  fps: 15,
  flush_pending_on_non_delta: false
)

# The connection (api_base / api_key) rides the transport's own per-chat
# RubyLLM::Context — pikuri needs no process-global RubyLLM.configure, and
# from_openai_server normalizes a server value that already ends in /v1.
# The connection's context_window (an explicit cap for a server pikuri's
# llama.cpp /props probe can't reach) rides it too; nil defers to that
# probe.
agent = Pikuri::Agent.new(
  transport: Pikuri::Agent::ChatTransport.from_openai_server(
    server: llm.server,
    model: llm.model,
    api_key: api_key,
    context_window: llm.context_window
  ),
  system_prompt: system_prompt,
  step_limit: Pikuri::Agent::Control::StepLimit.new(max: 20),
  cancellable: cancel_flag,
  interloper: interloper,
  streaming: true
) do |c|
  c.add_listener rate_limited_listener
  c.add_listener token_log
  c.add_tool Pikuri::Tool::WebSearch.build(**config.search.to_h)
  c.add_tool Pikuri::Tool::CALCULATOR
  c.add_tool Pikuri::Tool::WEB_SCRAPE
  c.add_tool Pikuri::Tool::FETCH
end

runner = PikuriWeb::AgentRunner.new(
  agent: agent,
  interloper: interloper,
  cancellable: cancel_flag,
  broadcaster: broadcaster,
  conversations: conversations,
  token_log: token_log
)

# The advisory lethal-trifecta map, printed once at boot: which of private
# data / untrusted content / egress this tool set actually holds, and
# which tool contributes each leg. Never blocks — this shell wires
# web_search + web_scrape + fetch, so it is expected to report egress.
puts agent.trifecta.render

# SSE heartbeat: a comment frame every 15 s. A write attempt is the only
# way to notice a silently vanished browser, whose /events drain loop
# would otherwise park a Puma thread forever.
Thread.new do
  loop do
    sleep 15
    broadcaster.broadcast_comment
  end
end

PikuriWeb::App.set :transcript, transcript
PikuriWeb::App.set :broadcaster, broadcaster
PikuriWeb::App.set :runner, runner
PikuriWeb::App.set :conversations, conversations
# Development mode buys template reloading (views/*.erb re-read per
# request) and in-browser exception pages. Ruby under lib/ is reloaded in
# neither mode: the agent, its listener stack and the runner's worker
# thread are long-lived instances wired above, so a class change needs a
# fresh process — see README, "Develop".
PikuriWeb::App.set :environment, dev ? :development : :production
PikuriWeb::App.set :show_exceptions, dev
PikuriWeb::App.set :bind, bind
PikuriWeb::App.set :port, port

# Ctrl+C hangs without this hook. Every open EventSource parks one Puma
# thread in the /events drain loop; Puma's graceful stop then waits for
# in-flight requests with no deadline, and the heartbeat above keeps
# those parked writes succeeding — so the wait lasts as long as a tab
# stays open. Puma's server thread fires :state, :stop immediately before
# it starts waiting, which makes it the hook that can still release the
# drain loops; Events#after_stopped and Sinatra's own INT trap both run
# on the far side of the wait, and Puma overwrites Sinatra's trap anyway.
puma_events = Puma::Events.new
puma_events.register(:state) do |state|
  broadcaster.close if %i[stop restart].include?(state)
end

PikuriWeb::App.set :server_settings, {
  # Each connected EventSource parks one Puma thread in the /events
  # drain loop; leave headroom over the default pool for a few tabs.
  min_threads: 0,
  max_threads: 16,
  events: puma_events,
  # Backstop for a request thread the sentinel can't reach: an SSE write
  # blocked on a socket whose peer vanished without a reset, or a :state
  # hook that a future Puma renames out from under us.
  force_shutdown_after: 5
}
PikuriWeb::App.set :server, :puma

PikuriWeb::App.run! do
  puts "pikuri-web listening on http://#{bind}:#{port} (agent: #{llm.model} @ #{llm.server})"
end
