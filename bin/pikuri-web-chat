#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the web chat shell built on Pikuri::Agent — the browser
# sibling of pikuri-tui's bin/pikuri-tui-chat, wiring the same agent /
# tool set into a Sinatra app instead of a Tuile screen.
#
# The `-chat` suffix is load-bearing: this script's tool set holds no
# disk, shell or repo tool, and the README sells that absence as the
# reason you can talk to it freely. An OS or code shell would be a
# sibling script reusing the same Pikuri-free plumbing — never extra
# tools added below. See AGENTS.md, "The chat script stays chat-only".
#
# Pin Bundler to this project's Gemfile so locked dependency versions win
# and the script works when invoked via a symlink from any working
# directory. `__dir__` resolves through symlinks, so this points at the
# real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'
require 'concurrent'
require 'ipaddr'
require 'optparse'

# Only for the :after_stopped hook wired below; Sinatra's run! loads the
# rest of Puma through the rackup handler.
require 'puma/events'

# pikuri-web has no published gemspec yet, so its lib/ is not on
# Bundler's load path. Adding it here lets `require 'pikuri_web'`
# resolve through Zeitwerk.
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-pdf'
require 'pikuri_web'

# Every flag here is one this shell alone owns and the config file has no
# home for. Which model a conversation talks to is deliberately *not* among
# them: connections come from [[llm]] in config.toml and from nowhere else,
# and which one a given conversation is on is that conversation's own saved
# state (`D_schema_complete_config`).
port = 4567
bind = '127.0.0.1'
dev = false

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-web-chat [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--port PORT', Integer, "HTTP port to listen on (default: #{port})") { |v| port = v }
  opts.on('--bind ADDR', "Address to bind (default: #{bind}; off loopback, gate it with [web] in config.toml)") do |v|
    bind = v
  end
  opts.on('--dev', 'Development mode: re-read views/*.erb per request, exception pages in the browser') { dev = true }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Load the layered config (XDG search path, shared with pikuri-tui) and
# overlay the CLI flags. There is no --api-key flag: a key must never
# travel on the command line (visible in ps / shell history) — it comes
# only from the config file. Boot-time, before Puma binds, so a bad file
# is a plain warn + exit rather than a server that serves a broken agent.
begin
  config = PikuriWeb::Config.load
  # Asked here rather than left to WebSearch.build below, so an unusable
  # [search] selection exits like any other config error instead of a
  # backtrace out of the agent wiring.
  Pikuri::Tool::Search::Engines.resolve(**config.search.to_h)
rescue PikuriWeb::Config::Error, ArgumentError => e
  warn "config error: #{e.message}"
  exit 2
end

# Every [[llm]], as transports. A conversation is minted on the one it saved
# and can be moved to any of the others (/model); the first is where one with
# nothing saved starts.
catalog = PikuriWeb::Agents::ModelCatalog.from_llms(config.llms)

# Conversation titles, when [titler] names one of those connections. One
# instance for the process: it keeps no per-conversation state, building a
# throwaway agent per title, and its transport carries whatever `params` that
# [[llm]] declared — which is how thinking gets turned off (README recipe).
# No [titler] at all leaves every conversation on its start stamp; the titler
# entry stays pickable in /model like any other, which is why it comes from the
# catalog rather than being built beside it.
titler =
  if (titler_llm = config.titler_llm)
    choice = catalog.find(titler_llm.name)
    PikuriWeb.logger.info(
      "titler: #{titler_llm.name.inspect} — #{choice.model} @ #{choice.server}" \
      "#{titler_llm.params.empty? ? ' (no params; expect slow titles from a thinking model)' : ''}"
    )
    PikuriWeb::Agents::Titler.new(transport: choice.transport, params_declared: !titler_llm.params.empty?)
  end

# A [[server]] naming no ceiling is left alone, so pikuri's /props probe sizes
# it from the box's own total_slots (`D_max_concurrent_requests`). `.limit`
# wins by decision rather than by ordering: ServerPermits marks an explicit
# size and refuses to let a probe's `.default` overwrite it, so this may run
# before or after the agent is built.
config.servers.each do |server|
  permits = server.max_concurrent_requests
  next if permits.nil?

  Pikuri::Agent::ServerPermits.limit(server.url, permits)
  PikuriWeb.logger.info("permits: #{server.id} at most #{permits} concurrent request(s) → #{server.url}")
end

Pikuri::Extractors::PDF.register

# — the Pikuri-free plumbing —

broadcaster = PikuriWeb::Web::Broadcaster.new

# Everything this shell persists lives under one folder named after the
# script, inside pikuri's own state root — so `rm -r` on it is a complete
# reset, and a sibling script (an OS or code shell) gets its own without
# either having to know what the other stores. Any future state goes here
# too, never straight into Paths.state.
state_root = Pikuri::Paths.state / 'pikuri-web-chat'

# Saved conversations fill the sidebar; opening one mints its agent.
conversations = PikuriWeb::Conversations::Store.new(
  root: state_root / 'conversations',
  shell: 'pikuri-web-chat'
)

# Diagnostics go to stderr — pikuri's per-subsystem loggers and
# PikuriWeb's own logger both default there. The browser shows the
# conversation transcript only (see AGENTS.md).

# — the agent (same wiring as bin/pikuri-tui-chat, plus the Interloper) —

system_prompt = Pikuri.prompts(:'pikuri-chat', :'agent-loop')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

# Turns run here rather than on a Sinatra request thread, and every
# conversation shares this one executor.
#
# Unbounded (grows on demand, reaps after 60s idle), and deliberately not
# derived from the server's slot count. A turn holds a thread here across its
# whole run_loop, tool execution included, but holds a server permit only for
# each HTTP request (`D_upstream_request_throttle`) — so any size tied to the
# server's capacity strands conversations behind turns that are off in a
# web_search using no slot. A bounded pool would also deadlock the day a tool
# spawns a sub-agent posting back here; a chat shell has no such tool
# (`D_chat_only_entry_point`), a sibling OS or code shell would.
#
# The real bound is the resident runners: a conversation admits one turn at a
# time (Agents::Runner#submit injects rather than starting a second), so turns in
# flight cannot exceed the conversations opened. Single-writer safety holds at
# any size regardless, because the partition is per conversation — two turns
# are two transcripts, two listeners, two agents, two disjoint folders. What
# does scale with concurrency is the process-wide search limiter noted at the
# tool wiring.
turn_executor = Concurrent::CachedThreadPool.new

# The serialization domain (`D_global_monitor`): route bodies and the turn
# job's bookkeeping brackets run as tasks on this one lock. Minted here and
# handed to everything guarded, the same way the broadcaster travels.
big_app_lock = PikuriWeb::BigAppLock.new

# One conversation's whole stack. Every agent this process runs comes from
# here, which is what keeps the boot-time trifecta report below true of all of
# them — a second wiring with an extra tool would silently invalidate it.
conversation_factory = lambda do |conversation|
  # The connection this conversation saved, or inherited from the one the tab
  # was reading. Resolving it *here* rather than parking it as a pending switch
  # puts the agent on the right connection from the start: the status bar reads
  # the model and the stated cap off the agent's own transport, so minting on
  # the wrong one would show both wrong until the first turn applied the switch.
  choice = catalog.resolve(model: conversation.model_at_mint, server: conversation.server_at_mint)
  # A connection edited out of config.toml since this conversation last spoke.
  # The pair is all there is to name it by — its [[llm]] name went with it.
  saved = conversation.model_at_mint && "#{conversation.model_at_mint} @ #{conversation.server_at_mint}"
  missing = saved unless choice
  choice ||= catalog.primary

  cancel_flag = Pikuri::Agent::Control::Cancellable.new
  interloper = Pikuri::Agent::Control::Interloper.new
  # Constructed up front so the Agent's ListenerList and the Agents::Runner (for
  # the status bar's token readout) see the same TokenLog instance.
  token_log = Pikuri::Agent::Listener::TokenLog.new

  transcript = PikuriWeb::Web::Transcript.new(lock: big_app_lock)
  sse_listener = PikuriWeb::Web::SseListener.new(
    transcript: transcript, broadcaster: broadcaster, conversation: conversation.id,
    lock: big_app_lock
  )

  # Coalesce streaming delta chunks at 15 fps before they reach the
  # kramdown-rendering SseListener: a fast llama.cpp can emit dozens of
  # deltas per second and re-rendering + broadcasting every one is wasted
  # work the user can't perceive. flush_pending_on_non_delta: false because
  # the Assistant / Thinking bookend events re-render the authoritative
  # final content (see StreamingMessage#finalize), so emitting the trailing
  # 0–66 ms of buffered deltas right before that is pure waste.
  rate_limited_listener = Pikuri::Agent::Listener::RateLimited.new(
    sse_listener,
    fps: 15,
    flush_pending_on_non_delta: false
  )

  # One transport per *connection*, shared by every agent on it rather than
  # rebuilt per conversation: a ChatTransport is a frozen Data, and pikuri
  # reads its fields to build a RubyLLM::Context per chat (Agent#build_context)
  # rather than holding the object open.
  agent = Pikuri::Agent.new(
    transport: choice.transport,
    system_prompt: system_prompt,
    cancellable: cancel_flag,
    interloper: interloper,
    streaming: true
  ) do |c|
    c.add_listener rate_limited_listener
    c.add_listener token_log
    # Tool instances are shared process-wide (CALCULATOR / WEB_SCRAPE / FETCH
    # are pikuri constants), which is safe by upstream contract rather than by
    # our pool size: pikuri declares a sharing posture per tool (its
    # DECISIONS.md, "Every tool declares one of four postures"). CALCULATOR is
    # +P_stateless+; FETCH and WEB_SCRAPE are +P_shared_benign+, sharing a
    # process-wide URL cache whose race that doc argues is harmless. WebSearch
    # is built per wiring for its keys, but is +P_shared_locked+ and paces on
    # class-level per-provider limiters, so a per-agent instance would throttle
    # no differently.
    #
    # The consequence of two conversations running at once is latency, not
    # corruption: the search limiter holds its mutex across the HTTP call, so
    # two agents searching at once serialize, and one tripping a provider's
    # circuit breaker cools down the other. Note this is not gated by
    # max_concurrent_requests — a tool call holds no server permit, so any two
    # open conversations can be in a search together however small the
    # server's slot count.
    c.add_tool Pikuri::Tool::WebSearch.build(**config.search.to_h)
    c.add_tool Pikuri::Tool::CALCULATOR
    c.add_tool Pikuri::Tool::WEB_SCRAPE
    c.add_tool Pikuri::Tool::FETCH
  end

  PikuriWeb::Agents::Runner.new(
    conversation: conversation,
    agent: agent,
    interloper: interloper,
    cancellable: cancel_flag,
    broadcaster: broadcaster,
    conversations: conversations,
    transcript: transcript,
    listener: sse_listener,
    executor: turn_executor,
    catalog: catalog,
    token_log: token_log,
    titler: titler,
    missing_connection: missing,
    lock: big_app_lock
  )
end

registry = PikuriWeb::Conversations::Registry.new(store: conversations, factory: conversation_factory,
                                               lock: big_app_lock)

# The advisory lethal-trifecta map, printed once at boot: which of private
# data / untrusted content / egress this tool set actually holds, and
# which tool contributes each leg. Never blocks — this shell wires
# web_search + web_scrape + fetch, so it is expected to report egress.
#
# Read off the conversation a fresh visitor would land on, which also warms it:
# one factory means this report describes every agent, not just this one.
puts big_app_lock.run { registry.open_id(registry.default.id) }.trifecta.render

# SSE heartbeat: a comment frame every 15 s. A write attempt is the only
# way to notice a silently vanished browser, whose /events drain loop
# would otherwise park a Puma thread forever.
Thread.new do
  Thread.current.name = 'sse-heartbeat'
  loop do
    sleep 15
    broadcaster.broadcast_comment
  end
end

PikuriWeb::Web::App.set :big_app_lock, big_app_lock
PikuriWeb::Web::App.set :broadcaster, broadcaster
PikuriWeb::Web::App.set :registry, registry
# Names, model ids and window sizes — no transport crosses this line. Also what
# gates /model out of the palette when there is only one connection.
PikuriWeb::Web::App.set :models, catalog.rows
# What a browser with no `thinking` / `tools` cookie sees. The file supplies
# only these starting values; the cookie a /thinking or /toollines pick writes
# outranks it from then on.
PikuriWeb::Web::App.set :show_thinking, config.show_thinking
PikuriWeb::Web::App.set :tool_lines, config.tool_lines
# Development mode buys template reloading (views/*.erb re-read per
# request) and in-browser exception pages. Ruby under lib/ is reloaded in
# neither mode: the agent, its listener stack and the runner's worker
# thread are long-lived instances wired above, so a class change needs a
# fresh process — see README, "Develop".
PikuriWeb::Web::App.set :environment, dev ? :development : :production
PikuriWeb::Web::App.set :show_exceptions, dev
PikuriWeb::Web::App.set :bind, bind
PikuriWeb::Web::App.set :port, port

# No [web] table means no middleware rather than a default password, so a bind
# off loopback is the one case where nobody at all is asked who they are —
# hence the warning, which is advice and not a refusal: a reverse proxy doing
# this job in front of us is a legitimate deployment (`D_one_password_gate`).
loopback = lambda do |address|
  address == 'localhost' || IPAddr.new(address).loopback?
rescue IPAddr::InvalidAddressError
  false
end

# Held rather than warned on the spot so it lands *under* Puma's banner, where
# the operator's eye already is, instead of scrolling past above it.
gate_warning = nil

if config.credentials
  PikuriWeb::Web::App.use PikuriWeb::Web::Gate, config.credentials
elsif !loopback.call(bind)
  gate_warning = <<~WARNING
    ⚠ WARNING: --bind #{bind} reaches past this machine and no password is set.
      Anyone who can reach #{bind}:#{port} can read, write and delete every
      conversation. Put a gate in ~/.config/pikuri/config.toml:

          [web]
          user     = "you"
          password = "a long passphrase"

      Basic credentials travel in the clear over plain HTTP, so off a trusted
      network put TLS in front (a reverse proxy) or reach it over a private
      overlay instead.
  WARNING
end

# Ctrl+C hangs without this hook. Every open EventSource parks one Puma
# thread in the /events drain loop; Puma's graceful stop then waits for
# in-flight requests with no deadline, and the heartbeat above keeps
# those parked writes succeeding — so the wait lasts as long as a tab
# stays open. Puma's server thread fires :state, :stop immediately before
# it starts waiting, which makes it the hook that can still release the
# drain loops; Events#after_stopped and Sinatra's own INT trap both run
# on the far side of the wait, and Puma overwrites Sinatra's trap anyway.
puma_events = Puma::Events.new
puma_events.register(:state) do |state|
  next unless %i[stop restart].include?(state)

  broadcaster.close
  # #shutdown, never #wait_for_termination: waiting for an in-flight turn here
  # would park this hook in front of Puma's graceful wait — the same bug the
  # broadcaster close above exists to prevent. An unfinished turn is lost, which
  # is the accepted trade (saves land at turn end; see Agents::Runner). Nothing in
  # this hook may enter the BigAppLock either — a wedged domain must not block
  # the exit.
  turn_executor.shutdown
end

PikuriWeb::Web::App.set :server_settings, {
  # Each connected EventSource parks one Puma thread in the /events
  # drain loop; leave headroom over the default pool for a few tabs.
  min_threads: 0,
  max_threads: 16,
  events: puma_events,
  # Backstop for a request thread the sentinel can't reach: an SSE write
  # blocked on a socket whose peer vanished without a reset, or a :state
  # hook that a future Puma renames out from under us.
  force_shutdown_after: 5
}
PikuriWeb::Web::App.set :server, :puma

PikuriWeb::Web::App.run! do
  primary = catalog.primary
  puts "pikuri-web listening on http://#{bind}:#{port} " \
       "(default connection: #{primary.model} @ #{primary.server}; #{catalog.choices.size} configured)"
  warn gate_warning if gate_warning
end
