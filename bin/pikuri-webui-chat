#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the web chat shell built on Pikuri::Agent — the browser
# sibling of pikuri-tui's bin/pikuri-tui-chat, wiring the same agent /
# tool set into a Sinatra app instead of a Tuile screen.
#
# The `-chat` suffix is load-bearing: this script's tool set holds no
# disk, shell or repo tool, and the README sells that absence as the
# reason you can talk to it freely. An OS or code shell would be a
# sibling script reusing the same Pikuri-free plumbing — never extra
# tools added below. See AGENTS.md, "The chat script stays chat-only".
#
# Pin Bundler to this project's Gemfile so locked dependency versions win
# and the script works when invoked via a symlink from any working
# directory. `__dir__` resolves through symlinks, so this points at the
# real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'
require 'ipaddr'
require 'optparse'

# Only for the :after_stopped hook wired below; Sinatra's run! loads the
# rest of Puma through the rackup handler.
require 'puma/events'

# pikuri-webui has no published gemspec yet, so its lib/ is not on
# Bundler's load path. Adding it here lets `require 'pikuri_webui'`
# resolve through Zeitwerk.
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-conversations'
require 'pikuri-pdf'
require 'pikuri-web'
require 'pikuri_webui'

# Every flag here is one this shell alone owns and the config file has no
# home for. Which model a conversation talks to is deliberately *not* among
# them: connections come from [[llm]] in config.toml and from nowhere else,
# and which one a given conversation is on is that conversation's own saved
# state (`D_schema_complete_config`).
port = 4567
bind = '127.0.0.1'
dev = false

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-webui-chat [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--port PORT', Integer, "HTTP port to listen on (default: #{port})") { |v| port = v }
  opts.on('--bind ADDR', "Address to bind (default: #{bind}; off loopback, gate it with [web] in config.toml)") do |v|
    bind = v
  end
  opts.on('--dev', 'Development mode: re-read views/*.erb per request, exception pages in the browser') { dev = true }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Load the layered config (XDG search path, shared with pikuri-tui) and
# overlay the CLI flags. There is no --api-key flag: a key must never
# travel on the command line (visible in ps / shell history) — it comes
# only from the config file. Boot-time, before Puma binds, so a bad file
# is a plain warn + exit rather than a server that serves a broken agent.
begin
  config = PikuriWebUI::Config.load
  # Asked here rather than left to Search.build below, so an unusable
  # [search] selection exits like any other config error instead of a
  # backtrace out of the agent wiring.
  Pikuri::Web::Search::Engines.resolve(**config.search.to_h)
rescue PikuriWebUI::Config::Error, ArgumentError => e
  warn "config error: #{e.message}"
  exit 2
end

# Every [[llm]], as transports. A conversation is minted on the one it saved
# and can be moved to any of the others (/model); the first is where one with
# nothing saved starts.
catalog = PikuriWebUI::Agents::ModelCatalog.from_llms(config.llms)

# Conversation titles, when [titler] names one of those connections. One
# instance for the process: it keeps no per-conversation state, building a
# throwaway agent per title, and its transport carries whatever `params` that
# [[llm]] declared — which is how thinking gets turned off (README recipe).
# No [titler] at all leaves every conversation on its start stamp; the titler
# entry stays pickable in /model like any other, which is why it comes from the
# catalog rather than being built beside it.
titler =
  if (titler_llm = config.titler_llm)
    choice = catalog.find(titler_llm.name)
    PikuriWebUI.logger.info(
      "titler: #{titler_llm.name.inspect} — #{choice.model} @ #{choice.server}" \
      "#{titler_llm.params.empty? ? ' (no params; expect slow titles from a thinking model)' : ''}"
    )
    Pikuri::Conversations::Titler.new(transport: choice.transport, params_declared: !titler_llm.params.empty?)
  end

# A [[server]] naming no ceiling is left alone, so the gem's /props probe sizes
# it from the box's own total_slots at its first turn (`D_max_concurrent_requests`).
# `.limit` wins by decision rather than by ordering: the Throttle refuses to let
# a probe's default overwrite an explicit size.
config.servers.each do |server|
  permits = server.max_concurrent_requests
  next if permits.nil?

  Pikuri::Conversations::Throttle.limit(server.url, permits)
  PikuriWebUI.logger.info("permits: #{server.id} at most #{permits} concurrent request(s) → #{server.url}")
end

Pikuri::Extractors::PDF.register

# — the Pikuri-free plumbing —

broadcaster = PikuriWebUI::Web::Broadcaster.new

# Everything this shell persists lives under one folder named after the
# script, inside pikuri's own state root — so `rm -r` on it is a complete
# reset, and a sibling script (an OS or code shell) gets its own without
# either having to know what the other stores. Any future state goes here
# too, never straight into Paths.state. The folder keeps the script's
# name from before the project became pikuri-webui, so existing
# conversations stay where they are (D_per_shell_state_root).
state_root = Pikuri::Paths.state / 'pikuri-web-chat'

# Saved conversations fill the sidebar; opening one mints its agent.
store = Pikuri::Conversations::Store.new(root: state_root / 'conversations', shell: 'pikuri-webui-chat')

# Diagnostics go to stderr — pikuri's per-subsystem loggers and
# PikuriWebUI's own logger both default there. The browser shows the
# conversation transcript only (see AGENTS.md).

# — the agent (same wiring as bin/pikuri-tui-chat) —

system_prompt = Pikuri.prompts(:'pikuri-chat', :'agent-loop')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

# Every agent's tools. One wiring for every agent this process runs, which is
# what keeps the boot-time trifecta report below true of all of them — a
# second wiring with an extra tool would silently invalidate it.
#
# Tool instances are shared process-wide (CALCULATOR / SCRAPE / FETCH are
# pikuri constants), which is safe by upstream contract: pikuri declares a
# sharing posture per tool. CALCULATOR is +P_stateless+; FETCH and SCRAPE are
# +P_shared_benign+, sharing a process-wide URL cache whose race that doc argues
# is harmless. web_search is built per agent for its keys, but is
# +P_shared_locked+ and paces on class-level per-provider limiters, so two
# conversations searching at once serialize, and one tripping a provider's
# circuit breaker cools down the other. No server permit gates that: a tool
# call holds none.
tools = lambda do |c|
  c.add_tool Pikuri::Web::Search.build(**config.search.to_h)
  c.add_tool Pikuri::Tool::CALCULATOR
  c.add_tool Pikuri::Web::SCRAPE
  c.add_tool Pikuri::Web::FETCH
end

# The live conversations: an agent each, built and run on threads of the gem's
# own — never on a Sinatra request thread — one thread per turn, unbounded.
# Load is rationed per *request* by the gem's Throttle, never per turn
# (`D_serial_turn_executor`). A conversation's listener is its Agents::Runner,
# which saves the turn before the gem lets it go idle.
live = Pikuri::Conversations.new(
  system_prompt: system_prompt,
  configure: ->(c, _conversation) { tools.call(c) },
  on_turn_end: ->(conversation, history) { conversation.listener.persist(history) },
  titler: titler
)

# The serialization domain (`D_global_monitor`): route bodies and the runners'
# bookkeeping run as tasks on this one lock. Minted here and handed to
# everything guarded, the same way the broadcaster travels.
big_app_lock = PikuriWebUI::BigAppLock.new

# One conversation's whole stack, opened.
conversation_factory = lambda do |entry|
  # The connection this conversation saved, or inherited from the one the tab
  # was reading. Resolved *here* so the agent boots on the right connection
  # rather than on the primary with a switch pending.
  choice = catalog.resolve(model: entry.model, server: entry.server)
  # A connection edited out of config.toml since this conversation last spoke.
  # The pair is all there is to name it by — its [[llm]] name went with it.
  missing = "#{entry.model} @ #{entry.server}" if entry.model && choice.nil?
  choice ||= catalog.primary

  transcript = PikuriWebUI::Web::Transcript.new(lock: big_app_lock)
  sse_listener = PikuriWebUI::Web::SseListener.new(
    transcript: transcript, broadcaster: broadcaster, conversation: entry.id, lock: big_app_lock
  )
  token_log = Pikuri::Agent::Listener::TokenLog.new

  PikuriWebUI::Agents::Runner.new(
    conversation: entry,
    store: store,
    catalog: catalog,
    broadcaster: broadcaster,
    transcript: transcript,
    listener: sse_listener,
    # Streaming deltas coalesced at 15 fps before the kramdown-rendering
    # SseListener: a fast llama.cpp emits dozens a second, and re-rendering and
    # broadcasting every one is work nobody can perceive.
    agent_listeners: [PikuriWebUI::Web::RateLimitedListener.new(sse_listener, fps: 15), token_log],
    token_log: token_log,
    missing_connection: missing,
    lock: big_app_lock
  ).open(live, transport: choice.transport)
end

registry = PikuriWebUI::Conversations::Registry.new(store: store, factory: conversation_factory, lock: big_app_lock)

# The advisory lethal-trifecta map, printed once at boot: which of private
# data / untrusted content / egress this tool set actually holds, and which
# tool contributes each leg. Never blocks — this shell wires web_search +
# web_scrape + fetch, so it is expected to report egress. Read off a throwaway
# agent with the one tool wiring, so it describes every conversation's agent
# without waiting for one to boot.
trifecta = begin
  agent = Pikuri::Agent.new(transport: catalog.primary.transport, system_prompt: system_prompt, &tools)
  agent.trifecta
ensure
  agent&.close
end
puts trifecta.render

# SSE heartbeat: a comment frame every 15 s. A write attempt is the only
# way to notice a silently vanished browser, whose /events drain loop
# would otherwise park a Puma thread forever.
Thread.new do
  Thread.current.name = 'sse-heartbeat'
  loop do
    sleep 15
    broadcaster.broadcast_comment
  end
end

PikuriWebUI::Web::App.set :big_app_lock, big_app_lock
PikuriWebUI::Web::App.set :broadcaster, broadcaster
PikuriWebUI::Web::App.set :registry, registry
# Messages' images are written into a conversation's folder ahead of its turn,
# and served back out of it, without a task around the disk.
PikuriWebUI::Web::App.set :store, store
# Static for the life of the process — one tool wiring — so the /trifecta
# dialog ships in every page rather than costing a route of its own.
PikuriWebUI::Web::App.set :trifecta, PikuriWebUI::Web::TrifectaView.render(trifecta)
# Names, model ids and window sizes — no transport crosses this line. Also what
# gates /model out of the palette when there is only one connection.
PikuriWebUI::Web::App.set :models, catalog.rows
# What a browser with no `thinking` / `tools` cookie sees. The file supplies
# only these starting values; the cookie a /thinking or /toollines pick writes
# outranks it from then on.
PikuriWebUI::Web::App.set :show_thinking, config.show_thinking
PikuriWebUI::Web::App.set :tool_lines, config.tool_lines
# Development mode buys template reloading (views/*.erb re-read per
# request) and in-browser exception pages. Ruby under lib/ is reloaded in
# neither mode: the agents and their listener stacks are long-lived
# instances wired above, so a class change needs a
# fresh process — see README, "Develop".
PikuriWebUI::Web::App.set :environment, dev ? :development : :production
PikuriWebUI::Web::App.set :show_exceptions, dev
PikuriWebUI::Web::App.set :bind, bind
PikuriWebUI::Web::App.set :port, port

# No [web] table means no middleware rather than a default password, so a bind
# off loopback is the one case where nobody at all is asked who they are —
# hence the warning, which is advice and not a refusal: a reverse proxy doing
# this job in front of us is a legitimate deployment (`D_one_password_gate`).
loopback = lambda do |address|
  address == 'localhost' || IPAddr.new(address).loopback?
rescue IPAddr::InvalidAddressError
  false
end

# Held rather than warned on the spot so it lands *under* Puma's banner, where
# the operator's eye already is, instead of scrolling past above it.
gate_warning = nil

if config.credentials
  PikuriWebUI::Web::App.use PikuriWebUI::Web::Gate, config.credentials
elsif !loopback.call(bind)
  gate_warning = <<~WARNING
    ⚠ WARNING: --bind #{bind} reaches past this machine and no password is set.
      Anyone who can reach #{bind}:#{port} can read, write and delete every
      conversation. Put a gate in ~/.config/pikuri/config.toml:

          [web]
          user     = "you"
          password = "a long passphrase"

      Basic credentials travel in the clear over plain HTTP, so off a trusted
      network put TLS in front (a reverse proxy) or reach it over a private
      overlay instead.
  WARNING
end

# Ctrl+C hangs without this hook. Every open EventSource parks one Puma
# thread in the /events drain loop; Puma's graceful stop then waits for
# in-flight requests with no deadline, and the heartbeat above keeps
# those parked writes succeeding — so the wait lasts as long as a tab
# stays open. Puma's server thread fires :state, :stop immediately before
# it starts waiting, which makes it the hook that can still release the
# drain loops; Events#after_stopped and Sinatra's own INT trap both run
# on the far side of the wait, and Puma overwrites Sinatra's trap anyway.
puma_events = Puma::Events.new
puma_events.register(:state) do |state|
  next unless %i[stop restart].include?(state)

  broadcaster.close
  # Cancels every turn and returns at once, never waiting: waiting for an
  # in-flight turn here would park this hook in front of Puma's graceful wait —
  # the same bug the broadcaster close above exists to prevent. An unfinished
  # turn is lost, which is the accepted trade (saves land at turn end). Nothing
  # in this hook may enter the BigAppLock either — a wedged domain must not
  # block the exit.
  live.shutdown
end

PikuriWebUI::Web::App.set :server_settings, {
  # Each connected EventSource parks one Puma thread in the /events
  # drain loop; leave headroom over the default pool for a few tabs.
  min_threads: 0,
  max_threads: 16,
  events: puma_events,
  # Backstop for a request thread the sentinel can't reach: an SSE write
  # blocked on a socket whose peer vanished without a reset, or a :state
  # hook that a future Puma renames out from under us.
  force_shutdown_after: 5,
  # Puma sets no ceiling of its own and buffers any body to disk before a route
  # can refuse it; this is a message's worth of images and text.
  http_content_length_limit: PikuriWebUI::Web::App::MAX_BODY_BYTES
}
PikuriWebUI::Web::App.set :server, :puma

PikuriWebUI::Web::App.run! do
  primary = catalog.primary
  puts "pikuri-webui listening on http://#{bind}:#{port} " \
       "(default connection: #{primary.model} @ #{primary.server}; #{catalog.choices.size} configured)"
  warn gate_warning if gate_warning
end
